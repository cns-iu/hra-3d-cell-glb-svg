# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Only a few sample organs are committed for now
HRA/outputs/*
!HRA/outputs/heart/
!HRA/outputs/kidney/
!HRA/outputs/lung/
!HRA/outputs/liver/
!HRA/outputs/glb report.csv

# JSONs are intermediate data (regenerated by the pipeline); raw cache files too
HRA/outputs/**/json/
HRA/outputs/**/hra_pop_raw.csv

# data/: HRA only needs the two files below
data/*
!data/hra_pop_raw.csv
!data/Supertree_colors_all_organs_A5.xlsx
